<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>محادثات المشاهير</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; background: #f4f4f4; }
    .login, .chat-app { display: none; }
    .active { display: block; }
    .container { max-width: 600px; margin: auto; padding: 20px; }
    h1 { text-align: center; }
    input, button { padding: 10px; margin: 5px 0; width: 100%; border-radius: 8px; border: 1px solid #ccc; }
    .celebs { display: grid; grid-template-columns: repeat(auto-fill,minmax(120px,1fr)); gap: 10px; }
    .celeb { background: #fff; padding: 10px; text-align: center; border-radius: 10px; cursor: pointer; box-shadow: 0 2px 5px rgba(0,0,0,.1); }
    .celeb img { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; }
    .chat { background: #fff; border-radius: 10px; padding: 10px; height: 400px; overflow-y: auto; margin-bottom: 10px; }
    .msg { margin: 5px 0; padding: 8px 12px; border-radius: 15px; max-width: 70%; }
    .me { background: #d1ffd1; margin-left: auto; text-align: right; }
    .them { background: #e1e1e1; margin-right: auto; text-align: left; }
    .back { margin-bottom: 10px; }
  </style>
</head>
<body>

<div class="login active container">
  <h1>تسجيل الدخول</h1>
  <input type="password" id="password" placeholder="أدخل كلمة السر">
  <button onclick="login()">دخول</button>
</div>

<div class="chat-app container">
  <div class="celebs" id="celebs"></div>
  <div id="chat-area" style="display:none;">
    <button class="back" onclick="backToCelebs()">⬅ رجوع</button>
    <h2 id="chat-name"></h2>
    <div class="chat" id="chat-box"></div>
    <input type="text" id="msg-input" placeholder="اكتب رسالتك...">
    <button onclick="sendMsg()">إرسال</button>
  </div>
</div>

<script>
  const PASSWORD = "12345"; // غير كلمة السر هنا
  let currentCeleb = null;
  const celebs = [
    {name: "محمد صلاح", img: "https://upload.wikimedia.org/wikipedia/commons/2/2e/Mohamed_Salah_in_2018.jpg"},
    {name: "كريستيانو رونالدو", img: "https://upload.wikimedia.org/wikipedia/commons/8/8c/Cristiano_Ronaldo_2018.jpg"},
    {name: "ليونيل ميسي", img: "https://upload.wikimedia.org/wikipedia/commons/c/c1/Lionel_Messi_20180626.jpg"}
  ];

  function login() {
    const pass = document.getElementById("password").value;
    if(pass === PASSWORD){
      document.querySelector(".login").classList.remove("active");
      document.querySelector(".chat-app").classList.add("active");
      loadCelebs();
    } else {
      alert("كلمة السر خاطئة!");
    }
  }

  function loadCelebs() {
    const container = document.getElementById("celebs");
    container.innerHTML = "";
    celebs.forEach((c,i)=>{
      const div = document.createElement("div");
      div.className="celeb";
      div.innerHTML = `<img src="${c.img}" alt=""><br>${c.name}`;
      div.onclick = ()=>openChat(i);
      container.appendChild(div);
    });
  }

  function openChat(index){
    currentCeleb = celebs[index];
    document.getElementById("celebs").style.display="none";
    document.getElementById("chat-area").style.display="block";
    document.getElementById("chat-name").innerText=currentCeleb.name;
    loadChat();
  }

  function backToCelebs(){
    document.getElementById("celebs").style.display="grid";
    document.getElementById("chat-area").style.display="none";
  }

  function sendMsg(){
    const input = document.getElementById("msg-input");
    if(!input.value.trim()) return;
    addMsg("me", input.value);
    saveMsg("me", input.value);
    input.value="";
  }

  function addMsg(sender, text){
    const box = document.getElementById("chat-box");
    const div = document.createElement("div");
    div.className="msg "+sender;
    div.innerText=text;
    box.appendChild(div);
    box.scrollTop=box.scrollHeight;
  }

  function saveMsg(sender, text){
    const key = "chat_"+currentCeleb.name;
    let chat = JSON.parse(localStorage.getItem(key) || "[]");
    chat.push({sender,text});
    localStorage.setItem(key, JSON.stringify(chat));
  }

  function loadChat(){
    const box = document.getElementById("chat-box");
    box.innerHTML="";
    const key = "chat_"+currentCeleb.name;
    let chat = JSON.parse(localStorage.getItem(key) || "[]");
    chat.forEach(m=> addMsg(m.sender, m.text));
  }
</script>

</body>
</html>
